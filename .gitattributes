# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Custom for Visual Studio
*.cs     text eol=lf diff=csharp
*.sln    text eol=lf merge=union
*.csproj text eol=lf merge=union
*.slnx   text eol=lf merge=union
*.xml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.zip binary
