# Auto detect text files and perform LF normalization
* text=auto

# Custom for Visual Studio
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs     text eol=lf diff=csharp
*.sln    text eol=lf merge=union
*.csproj text eol=lf merge=union
*.slnx   text eol=lf merge=union
*.xml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.ps1    text eol=lf
*.sql    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.zip binary
*.bak binary
