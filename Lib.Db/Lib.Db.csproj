<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<!-- <LangVersion>14.0</LangVersion> -->
	<!-- Library compatibility analyzers. NativeAOT publishing is validated by executable smoke projects. -->
	<IsAotCompatible>true</IsAotCompatible>

	<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	
	<!-- AOT/레거시 호환 경고 억제 (일반 JIT 컴파일 사용 시 영향 없음) -->
	<NoWarn>$(NoWarn);IL2060</NoWarn>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>

	  <EmitCompilerGeneratedFiles Condition="'$(EmitLibDbCompilerGeneratedFiles)' == 'true'">true</EmitCompilerGeneratedFiles>
	  <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\generated</CompilerGeneratedFilesOutputPath>
	  <NeutralLanguage>ko-KR</NeutralLanguage>
  
	  <!-- JIT Optimization -->
	  <TieredPGO>true</TieredPGO>
  
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.6.0" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <PropertyGroup>
    <Version>2.6.0</Version>
    <Authors>KIM JAE SEOK</Authors>
    <Description>High-Performance Data Access Library for .NET 10</Description>
    <PackageTags>sql-server;performance;aot;resilience</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Include symbols and source for debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Package Metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wotjr1649/Lib.Db.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="GenerateLibDbBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LibDbBuildInfoFile>$(IntermediateOutputPath)LibDbBuildInfo.g.cs</LibDbBuildInfoFile>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="$(LibDbBuildInfoFile)" Visible="false" />
      <LibDbBuildInfoLine Include="// &lt;auto-generated /&gt;" />
      <LibDbBuildInfoLine Include="namespace Lib.Db.Diagnostics%3B" />
      <LibDbBuildInfoLine Include="internal static class LibDbBuildInfo" />
      <LibDbBuildInfoLine Include="{" />
      <LibDbBuildInfoLine Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <LibDbBuildInfoLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(LibDbBuildInfoFile)" Lines="@(LibDbBuildInfoLine)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Lib.Db.IntegrationTests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Lib.Db.AotVerification</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
